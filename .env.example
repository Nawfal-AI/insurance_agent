# Copy this file to .env and fill in your actual key. Never commit .env itself.

# --- Option 1: Groq (RECOMMENDED — highest free-tier limit: 14,400 req/day) ---
# No credit card required. Get a key: https://console.groq.com (API Keys, left sidebar)
LLM_PROVIDER=groq
GROQ_API_KEY=your-key-here
GROQ_MODEL=llama-3.1-8b-instant

# --- Option 2: Google Gemini (free tier, but only 20 requests/day) ---
# LLM_PROVIDER=google
# GOOGLE_API_KEY=your-key-here
# Google deprecates/retires Gemini models frequently — if you get a
# RESOURCE_EXHAUSTED / "limit: 0" error, the model below may have been
# retired since this was written. Check current free-tier models at
# https://ai.google.dev/gemini-api/docs/pricing and override here:
# GEMINI_MODEL=gemini-flash-latest

# --- Option 3: Ollama (fully local, genuinely zero limit, no key needed) ---
# Install from https://ollama.com, then: ollama pull llama3.1
# LLM_PROVIDER=ollama

# --- Option 4: Anthropic (small one-time trial credit, not a persistent free tier) ---
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=your-key-here

# --- Option 5: OpenAI (paid, no free tier) ---
# LLM_PROVIDER=openai
# OPENAI_API_KEY=your-key-here
