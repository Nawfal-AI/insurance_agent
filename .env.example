# Copy this file to .env and fill in your actual key. Never commit .env itself.

# --- Option 1: Google Gemini (RECOMMENDED FREE OPTION) ---
# Persistent free tier, no card required. Get a key: https://aistudio.google.com/apikey
LLM_PROVIDER=google
GOOGLE_API_KEY=your-key-here
# Google deprecates/retires Gemini models frequently — if you get a
# RESOURCE_EXHAUSTED / "limit: 0" error, the model below may have been
# retired since this was written. Check current free-tier models at
# https://ai.google.dev/gemini-api/docs/pricing and override here:
GEMINI_MODEL=gemini-2.5-flash

# --- Option 2: Ollama (fully local, fully free, no key needed) ---
# Install from https://ollama.com, then: ollama pull llama3.1
# LLM_PROVIDER=ollama

# --- Option 3: Anthropic (small one-time trial credit, not a persistent free tier) ---
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=your-key-here

# --- Option 4: OpenAI (paid, no free tier) ---
# LLM_PROVIDER=openai
# OPENAI_API_KEY=your-key-here
