# Copy this file to .env and fill in your actual key. Never commit .env itself.

# --- LLM Provider ---
# Option 1: Groq (RECOMMENDED for free tier — 14,400 req/day, no credit card)
# Get key: https://console.groq.com
LLM_PROVIDER=groq
GROQ_API_KEY=your-key-here
GROQ_MODEL=llama-3.1-8b-instant

# Option 2: Anthropic
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=your-key-here

# Option 3: Google Gemini (20 req/day free)
# LLM_PROVIDER=google
# GOOGLE_API_KEY=your-key-here

# Option 4: Ollama (fully local, no key needed)
# LLM_PROVIDER=ollama

# Option 5: OpenAI (paid)
# LLM_PROVIDER=openai
# OPENAI_API_KEY=your-key-here

# --- Frontend ---
# URL of the FastAPI backend (used by Streamlit)
BACKEND_URL=http://localhost:8080

# --- AWS (only needed for cloud deployment) ---
# AWS_REGION=eu-central-1
# These are set as GitHub Secrets for CI/CD — do NOT put real values here
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
